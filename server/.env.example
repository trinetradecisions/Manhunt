# ==========================================
# MANHUNT SERVER — ENVIRONMENT CONFIGURATION
# ==========================================

# Port where Express & Socket.IO server listens
PORT=4000

# Node Environment ('development' | 'production')
NODE_ENV=development

# Allowed CORS Origins for WebSockets and HTTP endpoints
# Comma-separated list for production, e.g.:
# CORS_ORIGIN=https://manhunt.yourdomain.com,https://app.manhunt.io
CORS_ORIGIN=http://localhost:3000

# Audio transmission max size in bytes (Default: 5MB)
MAX_AUDIO_SIZE_BYTES=5242880

# Rate limits (window in ms, max requests)
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=120
