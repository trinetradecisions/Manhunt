# ==========================================
# MANHUNT VERCEL SERVERLESS ENVIRONMENT CONFIG
# ==========================================

# 1. Serverless State Store (Upstash Redis or Vercel KV)
# Provides sub-millisecond persistent game state across all serverless invocations.
# Free tier: 10,000 commands/day (Upstash or Vercel KV).
UPSTASH_REDIS_REST_URL=https://your-upstash-instance.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-rest-token
# Alternatively, if using Vercel KV:
# KV_REST_API_URL=https://your-kv-instance.kv.vercel-storage.com
# KV_REST_API_TOKEN=your-kv-rest-token

# 2. Realtime WebSocket Push (Pusher Channels)
# Enables instant WebSocket broadcast of locations, chat, catch codes, and state.
# Free tier: 200,000 messages/day, 100 concurrent connections.
PUSHER_APP_ID=your_pusher_app_id
PUSHER_KEY=your_pusher_key
PUSHER_SECRET=your_pusher_secret
PUSHER_CLUSTER=mt1
NEXT_PUBLIC_PUSHER_KEY=your_pusher_key
NEXT_PUBLIC_PUSHER_CLUSTER=mt1

# 3. Map Tile Configuration
# Standard OpenStreetMap tile server (default):
NEXT_PUBLIC_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png

# 4. WebRTC Voice / Audio STUN & TURN Servers (Optional for mobile NAT traversal)
NEXT_PUBLIC_STUN_URL=stun:stun.l.google.com:19302
# NEXT_PUBLIC_TURN_URL=turn:turn.yourdomain.com:3478
# NEXT_PUBLIC_TURN_USERNAME=username
# NEXT_PUBLIC_TURN_CREDENTIAL=credential
