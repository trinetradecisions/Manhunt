# ==========================================
# MANHUNT CLIENT — ENVIRONMENT CONFIGURATION
# ==========================================

# Socket.IO & Backend API URL
# Development: http://localhost:4000
# Production: https://api.yourdomain.com (Must be HTTPS in production for Geolocation API)
NEXT_PUBLIC_SOCKET_URL=http://localhost:4000

# OpenStreetMap / Custom Map Tile URL
# Standard OSM Tile Server (Development & low-volume testing only):
# https://tile.openstreetmap.org/{z}/{x}/{y}.png
# For high-traffic production, configure a custom Tile Server, Stadia Maps, Mapbox, or Protomaps:
NEXT_PUBLIC_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
