# Manhunt Web Environment Configuration Template
# Copy to .env in production / development

# Server Configuration
PORT=4000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:3000

# Client Configuration
NEXT_PUBLIC_SOCKET_URL=http://localhost:4000
NEXT_PUBLIC_MAP_TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png

# Storage Configuration
AUDIO_STORAGE_DRIVER=local # local | supabase | s3
AUDIO_STORAGE_PATH=./uploads/audio

# Security & Session
SESSION_SECRET=change-this-to-a-secure-random-32-byte-secret-in-production
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100
